# frontend/.env.example
# Copy this file to `.env.local` for local development (that copy is git-ignored).
# On Vercel, set the same variables under Project Settings > Environment Variables.

# Base URL of the Express API on Cloud Run, for example https://portfolio-api-xxxxx-uc.a.run.app
# Leave it EMPTY to run in demo mode: the site uses sample notes and projects and simulates the API timings.
BACKEND_URL=

# Shared secret the Next.js server sends to the API in the X-Internal-Key header.
# Must be identical to the API's INTERNAL_API_KEY and at least 32 characters long.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=
