# .editorconfig
# Shared editor settings (VS Code, JetBrains and most editors read this file),
# so indentation and line endings stay consistent no matter who edits the code.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses two trailing spaces for line breaks, so keep them.
[*.md]
trim_trailing_whitespace = false
